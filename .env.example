NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
DATABASE_URL=postgresql://ai_business_runtime:change-me@localhost:5432/ai_business
MIGRATION_DATABASE_URL=postgresql://ai_business:ai_business@localhost:5432/ai_business
# Configure the selected identity provider in a later ADR.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=

# AI provider credentials belong in a secret manager. SafeHandoffProvider needs no key.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# Instagram credentials must come from a secret manager; never commit real values.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# S3-compatible media storage. Keep real credentials in a secret manager.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

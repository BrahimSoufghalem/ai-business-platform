NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# Use a pooled Supabase URL with the restricted runtime role in hosted environments.
DATABASE_URL=postgresql://ai_business_runtime:change-me@localhost:5432/ai_business
# Use the direct/session Supabase URL only for migrations.
MIGRATION_DATABASE_URL=postgresql://ai_business:ai_business@localhost:5432/ai_business
# Supabase Auth is the Pilot OIDC provider; keep these provider-neutral in code.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=

# Pilot traffic protection and operational alert thresholds.
# The built-in limiter is process-local and intended for a single API instance only.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AGENT_MAX_REQUESTS=30
PILOT_HANDOFF_WAIT_ALERT_SECONDS=900

# AI provider credentials belong in a secret manager. SafeHandoffProvider needs no key.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_FAST_MODEL=
AI_PROVIDER_STRONG_MODEL=
AI_PROVIDER_MODEL_VERSION=
AI_PROVIDER_STRONG_MODEL_VERSION=
AI_PROVIDER_INPUT_COST_USD_PER_MILLION=1
AI_PROVIDER_OUTPUT_COST_USD_PER_MILLION=4
AI_PROVIDER_TIMEOUT_MS=15000

# Instagram credentials must come from a secret manager; never commit real values.
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_CREDENTIAL_ENCRYPTION_KEY=
INSTAGRAM_CREDENTIAL_KEY_VERSION=1
INSTAGRAM_WEBHOOK_MAX_BYTES=262144
# Optional stable instance name; defaults to hostname + process ID.
WORKER_ID=
# Instagram account IDs and access tokens are tenant-specific. Store tokens encrypted;
# do not add them to this file.

# S3-compatible media storage. Keep real credentials in a secret manager.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

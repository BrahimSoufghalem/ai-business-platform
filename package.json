{
  "name": "ai-business-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ai-business/db db:generate",
    "db:migrate": "pnpm --filter @ai-business/db db:migrate",
    "pilot:seed": "pnpm --filter @ai-business/db build && pnpm --filter @ai-business/db pilot:seed",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "pilot:gates": "pnpm security:secrets && pnpm security:audit && pnpm --filter @ai-business/customer-agent test:pilot-gate",
    "backup": "bash scripts/backup.sh",
    "restore:drill": "bash scripts/restore-drill.sh"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.5",
      "postcss": "8.5.28"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
